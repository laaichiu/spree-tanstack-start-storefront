{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],

  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}
