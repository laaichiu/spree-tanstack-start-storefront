{
  "name": "spree-tanstack-start-storefront",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3006",
    "build": "WRANGLER_WRITE_LOGS=false vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:checkout": "playwright test e2e/checkout",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "check:build-budget": "node tools/check-build-budget.mjs",
    "validate": "pnpm check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:build-budget",
    "deploy": "STOREFRONT_DEPLOY_ENV=production pnpm run build && pnpm check:build-budget && WRANGLER_WRITE_LOGS=false wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@cloudflare/vite-plugin": "^1.48.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@spree/sdk": "^1.2.1",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "@tanstack/start-server-core": "1.169.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "7.76.0",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.0.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.5",
    "wrangler": "^4.115.0"
  }
}
