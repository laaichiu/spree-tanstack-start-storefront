{
  "name": "spree-tanstack-storefront",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3006",
    "build": "WRANGLER_WRITE_LOGS=false vite build --minify",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:read-only": "pnpm verify:spree-runtime && playwright test e2e/accessibility.spec.ts e2e/layout.spec.ts e2e/responsive-typography.spec.ts e2e/security.spec.ts e2e/seo.spec.ts",
    "test:e2e:checkout": "playwright test --project=commerce",
    "verify:spree-commerce-runtime": "pnpm verify:spree-runtime && node tools/check-spree-commerce-runtime.mjs",
    "verify:spree-runtime": "node tools/check-spree-runtime-baseline.mjs",
    "measure:performance": "node tools/measure-performance.mjs",
    "check:build-budget": "node tools/check-build-budget.mjs",
    "deploy": "STOREFRONT_DEPLOY_ENV=production pnpm run build && pnpm check:build-budget && WRANGLER_WRITE_LOGS=false wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . && eslint --fix .",
    "check": "prettier --check .",
    "check:docs": "node tools/check-documentation.mjs",
    "validate": "pnpm check && pnpm check:docs && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:build-budget",
    "test:e2e:checkout:release": "E2E_COMMERCE_RELEASE=true playwright test --project=commerce"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@spree/sdk": "6.0.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/start-server-core": "1.169.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "parse5": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.90.0",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
